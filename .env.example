# ==============================================================================
# Proyecto Final (PSets #1 a #4): Nowcasting de Ventas Sectoriales (F104 -> IMAEC)
# Copie este archivo a .env y complete sus credenciales de Snowflake.
# ¡Nunca suba el archivo .env con credenciales reales al repositorio!
# ==============================================================================

# ------------------------------------------------------------------ Snowflake
SNOWFLAKE_ACCOUNT=tu_organizacion-tu_cuenta
SNOWFLAKE_USER=TU_USUARIO
SNOWFLAKE_PASSWORD=TU_PASSWORD
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PSET2_DB
SNOWFLAKE_SCHEMA=ANALYTICS

# --------------------------------------------------------------------- Kestra
KESTRA_PORT=8080
KESTRA_USER=admin@kestra.io:Admin1234

# ------------------------------------------- MLflow Tracking & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nowcasting-f104-sri
MLFLOW_MODEL_NAME=nowcasting-f104-modelo
MLFLOW_MODEL_ALIAS=champion

# --------------------------------------- Servicio de Predicción (FastAPI) & CI
API_PORT=8000
MODO_RESPALDO=false
TOKEN_ADMIN=bce-coyuntura-2026
GUARDAR_SNOWFLAKE=true

# ------------------------------------------------- Tablero de Monitoreo (UI)
TABLERO_PORT=8501
